<?xml version="1.0" encoding="utf-8"  ?>
<robot name="quad_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="package://jumping_leg/models/commons.xacro"/>
    <xacro:include filename="$(find jumping_leg)/models/leg_simple.xacro"/>

	<xacro:arg name="body_width" default="0.45" />
	<xacro:arg name="body_length" default="0.8" />
	<xacro:arg name="body_height" default="0.20" />
	<xacro:arg name="body_mass" default="12" />

	<xacro:property name="body_width" default="$(arg body_width)" />
	<xacro:property name="body_length" default="$(arg body_length)" />
	<xacro:property name="body_height" default="$(arg body_height)" />
	<xacro:property name="body_mass" default="$(arg body_mass)" />

    <xacro:macro name="default_contact_params" params="">
        <contact>
        <!-- 
        Defaults maybe are these (from bullet3/examples/Importers/ImportURDFDemo/URDFJointTypes.h line 33)
        URDFLinkContactInfo()
            : m_lateralFriction(0.5),
            m_rollingFriction(0),
            m_spinningFriction(0),
            m_restitution(0),
            m_inertiaScaling(1),
            m_contactCfm(0),
            m_contactErp(0),
            m_contactStiffness(1e4),
            m_contactDamping(1)
        -->
            <lateral_friction value="1"/>
            <rolling_friction value="0.00001"/>
        </contact>
    </xacro:macro>



    <link name="body_link">
		<visual name = "body_link_v">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="${body_length} ${body_width} ${body_height}"/>
			</geometry>
	   	</visual>
  		<collision name = "body_link_c">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="${body_length} ${body_width} ${body_height}"/>
			</geometry>
	   	</collision>
		<xacro:box_inertial mass="${body_mass}"
                            x="${body_width}" y="${body_length}" z="${body_height}"
                            pose_xyz = "0 0 0"
                            pose_rpy = "0 0 0"/>
        <xacro:default_contact_params />
	</link>

    <link name="after_x"/>
    <link name="after_y"/>
    <link name="after_z"/>
    <link name="after_rx"/>
    <link name="after_ry"/>
    <link name="after_rz"/>


    <link name="world"/>
	<joint name="linear_x" type="prismatic">
        <parent link="world"/>
        <child link="after_x"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-100.0" upper="100.0" effort="112" velocity="20"/>
        <axis xyz="1 0 0"/>
    </joint>
	<joint name="linear_y" type="prismatic">
        <parent link="after_x"/>
        <child link="after_y"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-100.0" upper="100.0" effort="112" velocity="20"/>
        <axis xyz="0 1 0"/>
    </joint>
	<joint name="linear_z" type="prismatic">
        <parent link="after_y"/>
        <child link="after_z"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-100.0" upper="100.0" effort="112" velocity="20"/>
        <axis xyz="0 0 1"/>
    </joint>
    <joint name="angular_x" type="revolute">
    	<parent link="after_z"/>
    	<child link="after_rx"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-1000" upper="1000" effort="112" velocity="20"/>
        <axis xyz="1 0 0"/>
	</joint>
    <joint name="angular_y" type="revolute">
    	<parent link="after_rx"/>
    	<child link="after_ry"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-1000" upper="1000" effort="112" velocity="20"/>
        <axis xyz="0 1 0"/>
	</joint>
    <joint name="angular_z" type="revolute">
    	<parent link="after_ry"/>
    	<child link="after_rz"/>
		<dynamics damping="0.1" friction="0.1"/>
       	<limit lower="-1000" upper="1000" effort="112" velocity="20"/>
        <axis xyz="0 0 1"/>
	</joint>

</robot>
