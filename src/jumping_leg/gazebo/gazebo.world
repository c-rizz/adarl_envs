<sdf version="1.4">
<world name="default">
    <include>
        <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.80665</gravity>


    <plugin name='lr_gym_ros_env' filename='libgazebo_gym_env_plugin.so'>
      <joint_state_smoothing value="0.0"/>
    </plugin>
    <plugin name='xbot2_gz_clock' filename='libxbot2_gz_clock.so'/> <!-- xbot2 clock plugin (enables the clock synchronization on the XBot2 side according to Gazebo's simulation time) -->

    <physics name="ode_unlimited_ap" type="ode" default="true">

        <max_step_size> 0.0009765625 </max_step_size> <!-- This is exactly 1/1024, this way we can exactli step at 1/128 Hz without floating rounding errors -->
        <real_time_update_rate>-1</real_time_update_rate>
        <!-- <real_time_factor> 1</real_time_factor> -->
        
        <!-- ODE -->
        <ode> 
          <solver>
            <!-- <type> quick </type>
            <sor>1.3</sor>-->
            <!-- number of iterations for each step, def. to 50 (the higher the better the accuracy is) -->
            <iters> 200 </iters>
            <!-- <friction_model> pyramid_model</friction_model> -->
          </solver>
          <constraints>
            <!-- soft constraint force mixing (def. to 0) -->
<!--            <cfm>0.00001</cfm>-->
            <!-- soft error reduction parameter (def. to 0.2) -->
            <!-- <erp>0.2</erp> -->
            <!-- <contact_max_correcting_vel>100</contact_max_correcting_vel>  -->
            <!-- <contact_surface_layer>0.001</contact_surface_layer> -->
          </constraints>
        </ode>
        <!-- Bullet -->
        <!-- <bullet> 
          <solver> 
            <iters> 100 </iters>
            <sor>1.3</sor>
          </solver> 
          <constraints>
            <cfm>0</cfm>
            <erp>0.2</erp>
            <contact_surface_layer>0</contact_surface_layer>
            <slit_impulse> 1 </slit_impulse>
            <split_impulse_penetration_threshold> -0.01</split_impulse_penetration_threshold>
          </constraints>
        </bullet> -->
        <!-- Dart -->
        <!-- <dart>    
          <collision_detector> bullet </collision_detector>
          <solver> 
            <solver_type> pgs </solver_type>
          </solver>
        </dart> -->
        <!-- Simbody -->
        <!-- <simbody> 
        </simbody> -->
    </physics>

    <physics name="bullet_5x" type="bullet">
      <max_step_size>0.0041666</max_step_size> <!-- 240fps, bullet should be optimized for this frequency -->
      <real_time_update_rate>1200</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <bullet>
        <solver>
          <type>sequential_impulse</type>
          <iters>10</iters>
          <sor>1</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_surface_layer>0.001</contact_surface_layer>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.04</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
    </physics>

    <physics name="bullet_walltime" type="bullet">
      <max_step_size>0.0041666</max_step_size> <!-- 240fps, bullet should be optimized for this frequency -->
      <real_time_update_rate>240</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <bullet>
        <solver>
          <type>sequential_impulse</type>
          <iters>10</iters>
          <sor>1</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_surface_layer>0.001</contact_surface_layer>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.04</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
    </physics>

    <physics name="bullet_unlimited" type="bullet">
      <max_step_size>0.0041666</max_step_size> <!-- 240fps, bullet should be optimized for this frequency -->
      <real_time_update_rate>-1</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <bullet>
        <solver>
          <type>sequential_impulse</type>
          <iters>10</iters>
          <sor>1</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_surface_layer>0.001</contact_surface_layer>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.04</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
    </physics>

    <physics name="ode_5x" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>5000</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <ode>
        <solver>
          <island_threads>4</island_threads>
        </solver>
      </ode>
    </physics>

    <physics name="ode_walltime" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <ode>
        <solver>
          <island_threads>4</island_threads>
        </solver>
      </ode>
    </physics>

    <physics name="ode_unlimited" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>-1</real_time_update_rate> <!-- steps done in each real-time second, -1 does as many as possible-->
      <ode>
        <solver>
          <island_threads>4</island_threads>
        </solver>
      </ode>
    </physics>



    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>                                                                                                                                                                             
            <contact>                                                                                                                                                                           
              <ode>                                                                                                                                                                             
                <kp>2e+05</kp>                                                                                                                                                                  
                <kd>80</kd>
                <!-- Equivalent to CFM = 10e-2, ERP = 0.2, with step size = 10^-3,
                    See http://www.ode.org/ode-latest-userguide.html#sec_3_8_2 -->                                                                                                                                                                 
              </ode>
            </contact>                                                                                                                                                                          
            <friction>
              <!--
              <bounce>
                <restitution_coefficient> 0.5 </restitution_coefficient>
                <threshold> 0.5 </threshold>
              </bounce>
              -->
              <torsional>
                <coefficient>0.5</coefficient>
              </torsional>
              <ode>  <!-- gazebo reads the ode tag even for bullet, see https://github.com/osrf/gazebo/blob/gazebo9/gazebo/physics/bullet/BulletSurfaceParams.cc -->
                <!-- Some Coulomb friction coefficient examples:
                    https://web.mit.edu/8.13/8.13c/references-fall/aip/aip-handbook-section2d.pdf
                    https://engineeringlibrary.org/reference/coefficient-of-friction
                    https://www.engineeringtoolbox.com/friction-coefficients-d_778.html
                    https://www.tribonet.org/wiki/friction-coefficients-in-atmosphere-and-vacuum/
                -->                                                                                                                                                                        
                <mu>1</mu>                                                                                                                                                                    
                <mu2>1</mu2>                                                                                                                                                                  
              </ode>                                                                                                                                                                            
            </friction>                                                                                                                                                                         
          </surface>
        </collision>
      </link>
    </model>


    <gui fullscreen='0'>
        <camera name='user_camera'>
          <pose>0.0 5.0 1.0 0.0 0.0 -1.5708</pose>
            <view_controller>orbit</view_controller>
            <projection_type>perspective</projection_type>
          </camera>
    </gui>
</world>
</sdf>
