<?xml version="1.0" encoding="utf-8"  ?>
<robot name="quad_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="package://jumping_leg/models/commons.xacro"/>
    <xacro:include filename="$(find jumping_leg)/models/leg_simple.xacro"/>

	<!-- <xacro:arg name="hip_out_offset" default="0.2146" />  -->
	<xacro:arg name="hip_out_offset" default="0.05" />
	<xacro:arg name="front_legs_pos" default="0.25" />
	<xacro:arg name="back_legs_pos" default="-0.25" />

	<xacro:arg name="thigh_width" default="0.05" />
	<xacro:arg name="thigh_height" default="0.3" />
	<xacro:arg name="thigh_mass" default="3.3712777" />
	<xacro:arg name="thigh_color" default="1 0.5088 0.0468 1" />

	<xacro:arg name="knee_y_offset" default="-0.05" />

	<xacro:arg name="shin_width" default="0.05" />
	<xacro:arg name="shin_height" default="0.451" />
	<xacro:arg name="shin_mass" default="1.3106594" />
	<xacro:arg name="shin_color" default="1 0.5088 0.0468 1" />

	<xacro:arg name="body_width" default="0.3" />
	<xacro:arg name="body_length" default="0.6" />
	<xacro:arg name="body_height" default="0.15" />
	<xacro:arg name="body_mass" default="8" />

	<xacro:arg name="hip_friction" default="0.1" />
	<xacro:arg name="knee_friction" default="0.1" />




	<xacro:property name="legs_out_offset"  default="$(arg hip_out_offset)" /> 
	<xacro:property name="front_legs_pos"  default="$(arg front_legs_pos)" /> 
	<xacro:property name="back_legs_pos"  default="$(arg back_legs_pos)" /> 

	<xacro:property name="thigh_width"  default="$(arg thigh_width)" />
	<xacro:property name="thigh_height" default="$(arg thigh_height)" />
	<xacro:property name="thigh_mass"   default="$(arg thigh_mass)" />
	<xacro:property name="thigh_color"  default="$(arg thigh_color)" /> 

	<xacro:property name="knee_y_offset"  default="$(arg knee_y_offset)" /> 

	<xacro:property name="shin_width"  default="$(arg shin_width)" />
	<xacro:property name="shin_height" default="$(arg shin_height)" />
	<xacro:property name="shin_mass"   default="$(arg shin_mass)" />
	<xacro:property name="shin_color"  default="$(arg shin_color)" /> 

	<xacro:property name="body_width" default="$(arg body_width)" />
	<xacro:property name="body_length" default="$(arg body_length)" />
	<xacro:property name="body_height" default="$(arg body_height)" />
	<xacro:property name="body_mass" default="$(arg body_mass)" />

	
	<xacro:property name="knee_friction" default="$(arg knee_friction)" />
	<xacro:property name="hip_friction" default="$(arg hip_friction)" />



    <link name="body_link">
		<visual name = "body_link_v">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="${body_length} ${body_width} ${body_height}"/>
			</geometry>
	   	</visual>
  		<collision name = "body_link_c">
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="${body_length} ${body_width} ${body_height}"/>
			</geometry>
	   	</collision>
		<xacro:box_inertial mass="${body_mass}"
                            x="${body_width}" y="${body_length}" z="${body_height}"
                            pose_xyz = "0 0 0"
                            pose_rpy = "0 0 0"/>
	</link>


    <xacro:leg_simple   hip_x_offset = "${front_legs_pos}"
                        hip_y_offset = "${body_width/2 + legs_out_offset}"
                        hip_z_offset = "0"
                        thigh_width  = "${thigh_width}"
                        thigh_height = "${thigh_height}"
                        thigh_mass = "${thigh_mass}"
                        thigh_color = "${thigh_color}"
                        knee_y_offset = "${knee_y_offset}"
                        shin_width = "${shin_width}"
                        shin_height = "${shin_height}"
                        shin_mass = "${shin_mass}"
                        shin_color = "${shin_color}"
                        hip_friction = "${hip_friction}"
                        knee_friction = "${knee_friction}"
                        parent_link = "body_link"
                        leg_name = "front_left"
                        is_left_leg = "true"/>

    <xacro:leg_simple   hip_x_offset = "${front_legs_pos}"
                        hip_y_offset = "${body_width/2 + legs_out_offset}"
                        hip_z_offset = "0"
                        thigh_width  = "${thigh_width}"
                        thigh_height = "${thigh_height}"
                        thigh_mass = "${thigh_mass}"
                        thigh_color = "${thigh_color}"
                        knee_y_offset = "${knee_y_offset}"
                        shin_width = "${shin_width}"
                        shin_height = "${shin_height}"
                        shin_mass = "${shin_mass}"
                        shin_color = "${shin_color}"
                        hip_friction = "${hip_friction}"
                        knee_friction = "${knee_friction}"
                        parent_link = "body_link"
                        leg_name = "front_right"
                        is_left_leg = "false"/>

    <xacro:leg_simple   hip_x_offset = "${back_legs_pos}"
                        hip_y_offset = "${body_width/2 + legs_out_offset}"
                        hip_z_offset = "0"
                        thigh_width  = "${thigh_width}"
                        thigh_height = "${thigh_height}"
                        thigh_mass = "${thigh_mass}"
                        thigh_color = "${thigh_color}"
                        knee_y_offset = "${knee_y_offset}"
                        shin_width = "${shin_width}"
                        shin_height = "${shin_height}"
                        shin_mass = "${shin_mass}"
                        shin_color = "${shin_color}"
                        hip_friction = "${hip_friction}"
                        knee_friction = "${knee_friction}"
                        parent_link = "body_link"
                        leg_name = "back_left"
                        is_left_leg = "true"/>

    <xacro:leg_simple   hip_x_offset = "${back_legs_pos}"
                        hip_y_offset = "${body_width/2 + legs_out_offset}"
                        hip_z_offset = "0"
                        thigh_width  = "${thigh_width}"
                        thigh_height = "${thigh_height}"
                        thigh_mass = "${thigh_mass}"
                        thigh_color = "${thigh_color}"
                        knee_y_offset = "${knee_y_offset}"
                        shin_width = "${shin_width}"
                        shin_height = "${shin_height}"
                        shin_mass = "${shin_mass}"
                        shin_color = "${shin_color}"
                        hip_friction = "${hip_friction}"
                        knee_friction = "${knee_friction}"
                        parent_link = "body_link"
                        leg_name = "back_right"
                        is_left_leg = "false"/>

    <!-- <link name="world"/>
	<joint name="world_to_body" type="floating">
        <parent link="world"/>
        <child link="body_link"/>
    </joint> -->

</robot>
