<?xml version="1.0"?>

<robot name="protoleg" xmlns:xacro="http://www.ros.org/wiki/xacro">
    

	<xacro:arg name="hip_y_offset" default="0.3" />

	<xacro:arg name="thigh_width" default="0.05" />
	<xacro:arg name="thigh_height" default="0.3" />
	<xacro:arg name="thigh_mass" default="3.3712777" />
	<xacro:arg name="thigh_color" default="1 0.5088 0.0468 1" />

	<xacro:arg name="knee_y_offset" default="-0.1182" />

	<xacro:arg name="shin_width" default="0.05" />
	<xacro:arg name="shin_height" default="0.451" />
	<xacro:arg name="shin_mass" default="1.3106594" />
	<xacro:arg name="shin_color" default="1 0.5088 0.0468 1" />

	<xacro:arg name="rail_color" default="1 1 1 1" /> 
	<xacro:arg name="rail_width" default="0.08" />
	<xacro:arg name="rail_length" default="0.1" />
	<xacro:arg name="rail_height" default="2" />
	<xacro:arg name="rail_mass" default="1000" />

	<xacro:arg name="slider_width" default="0.15" />
	<xacro:arg name="slider_length" default="0.01" />
	<xacro:arg name="slider_height" default="0.15" />
	<xacro:arg name="slider_y_offset" default="0.01" />
	<xacro:arg name="slider_mass" default="8" />

	<xacro:arg name="hip_friction" default="0.1" />
	<xacro:arg name="rail_friction" default="0.0" />
	<xacro:arg name="knee_friction" default="0.1" />

	<xacro:arg name="rail_x" default="0.0" />
	<xacro:arg name="rail_y" default="0.0" />
	<xacro:arg name="rail_z" default="0.0" />
	<xacro:arg name="rail_roll" default="0.0" />
	<xacro:arg name="rail_pitch" default="0.0" />
	<xacro:arg name="rail_yaw" default="0.0" />


	<xacro:property name="hip_y_offset"  default="$(arg hip_y_offset)" /> 

	<xacro:property name="thigh_width"  default="$(arg thigh_width)" />
	<xacro:property name="thigh_height" default="$(arg thigh_height)" />
	<xacro:property name="thigh_mass"   default="$(arg thigh_mass)" />
	<xacro:property name="thigh_color"  default="$(arg thigh_color)" /> 

	<xacro:property name="knee_y_offset"  default="$(arg knee_y_offset)" /> 

	<xacro:property name="shin_width"  default="$(arg shin_width)" />
	<xacro:property name="shin_height" default="$(arg shin_height)" />
	<xacro:property name="shin_mass"   default="$(arg shin_mass)" />
	<xacro:property name="shin_color"  default="$(arg shin_color)" /> 

	<xacro:property name="rail_color" default="$(arg rail_color)" />
	<xacro:property name="rail_width" default="$(arg rail_width)" />
	<xacro:property name="rail_length" default="$(arg rail_length)" />
	<xacro:property name="rail_height" default="$(arg rail_height)" />
	<xacro:property name="rail_mass" default="$(arg rail_mass)" />
	
	<xacro:property name="slider_width" default="$(arg slider_width)" />
	<xacro:property name="slider_length" default="$(arg slider_length)" />
	<xacro:property name="slider_height" default="$(arg slider_height)" />
	<xacro:property name="slider_mass" default="$(arg slider_mass)" />
	<xacro:property name="slider_y_offset" default="$(arg slider_y_offset)" />
	
	<xacro:property name="knee_friction" default="$(arg knee_friction)" />
	<xacro:property name="hip_friction" default="$(arg hip_friction)" />
	<xacro:property name="rail_friction" default="$(arg rail_friction)" />
	<xacro:property name="rail_x" default="$(arg rail_x)" />
	<xacro:property name="rail_y" default="$(arg rail_y)" />
	<xacro:property name="rail_z" default="$(arg rail_z)" />
	<xacro:property name="rail_roll" default="$(arg rail_roll)" />
	<xacro:property name="rail_pitch" default="$(arg rail_pitch)" />
	<xacro:property name="rail_yaw" default="$(arg rail_yaw)" />
	<xacro:property name="id" default="1" />


    <xacro:property name="femur_com_xyz" value="${-1.7807105e-02 * mmTom} ${-3.4271947e+01 * mmTom} ${-2.2282064e+02 * mmTom}" />
    <xacro:property name="femur_com_rpy" value="0 0 0" />
    <xacro:property name="shin_com_xyz" value="${9.2284672e-04 * mmTom} ${1.759883e+01 * mmTom} ${-1.8730054e+02 * mmTom}" />
    <xacro:property name="shin_com_rpy" value="0 0 0" />


	<xacro:macro name="box_inertial" params="mass x y z pose_xyz pose_rpy">
		<inertial>
			<origin xyz="${pose_xyz}" rpy="${pose_rpy}"/>
			<mass value="${mass}" />
			<inertia ixx="${0.083 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${0.083 * mass * (x*x + z*z)}" iyz="0.0" izz="${0.083 * mass * (x*x + y*y)}"/>
		</inertial>
	</xacro:macro>
    <xacro:macro name="small_inertial" params="">
		<xacro:box_inertial mass="0.0001"
                            x="0.001" y="0.001" z="0.001"
                            pose_xyz = "0 0 0"
                            pose_rpy = "0 0 0"/>
    </xacro:macro>

    <!-- scale -->
    <xacro:property name="mmTom" value="0.001" />
    <xacro:property name="dmTom" value="0.1" />
    <xacro:property name="mm2Tom2" value="${0.001*0.001}" />
    <xacro:property name="tonsToKg" value="1000.0" />
    <xacro:property name="kgmm2_2_kgm2" value="${1e-06}" />

    <xacro:property name="PI" value="3.14159265359" />
    <xacro:property name="PI_2" value="1.57079632679" />
    <xacro:property name="PI_4" value="0.7853981633974483" />
    <xacro:property name="DEG2RAD" value="${PI/180.0}" />

    <xacro:property name="sliding_guide_static_friction" value="0.0" />
    <xacro:property name="sliding_guide_dyn_friction" value="0.01" />
    <!--<xacro:property name="sliding_guide_dyn_friction" value="50.0" />-->

    <!--<xacro:property name="base_link_mass_compensation" value="2.0" />
    <xacro:property name="payload_mass" value="${0.0 + base_link_mass_compensation}" />-->
    <xacro:property name="payload_mass" value="${0.0}" />

    <xacro:property name="camera_height" value="0.5" />
    <xacro:property name="camera_depth" value="1.0" />

    <xacro:property name="fts_sphere_radius" value="0.05" />
    <xacro:property name="fts_delta" value="0.000" />
    <xacro:property name="aux_mass_tip" value="0.01" />

    <!-- color -->
    <material name="darkblue">
        <color rgba="0.0 0.3 0.9 1"/>
    </material>

    <material name="dark">
        <color rgba="0.6 0.6 0.6 1"/>
    </material>

    <material name="sky_blue">
            <color rgba="0.13 0.44 0.70 1"/>
    </material>
    <material name="grey">
        <color rgba=" 0.6 0.6 0.6 1"/>
    </material>
    <material name="black">
        <color rgba="0.4 0.4 0.4 1"/>
    </material>
    <material name="brown">
        <color rgba="0.59 0.29 0.0 1"/>
    </material>

    <xacro:macro name="fake_inertial">
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            <origin xyz="0 0 0"/>
        </inertial>
    </xacro:macro>

    
    <xacro:property name="test_rig_thickness" value="0.1" />
    <xacro:property name="test_rig_height" value="2.0" />
    <xacro:property name="hip_mounting_offset" value="0.08" />


    <link name="world" />

    <joint name="world_test_rig" type="fixed">
        <parent link="world" />
        <child link="test_rig" />
        <origin xyz="0 0 ${test_rig_height/2}" />
    </joint>
    
    <link name="test_rig"> 

        <visual>
            <origin rpy="0 0 0" xyz="0 0 0" />
            <geometry>
                <box size="${test_rig_thickness} ${test_rig_thickness} ${test_rig_height}" />
            </geometry>
            <material name="brown"/>
        </visual>
        
        <inertial>
            <mass value="1000.0" />
            <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>

    </link> 

    
    
    <link name="body"> 
		<visual name = "slider_link_v">
			<origin xyz="0 ${slider_y_offset} 0" rpy="0 0 0"/>
			<geometry>
				<box size="${slider_width} ${slider_length} ${slider_height}"/>
			</geometry>
	   	</visual>
  		<collision name = "slider_link_c">
			<origin xyz="0 ${slider_y_offset} 0" rpy="0 0 0"/>
			<geometry>
				<box size="${slider_width} ${slider_length} ${slider_height}"/>
			</geometry>
	   	</collision>
        <inertial>
            <origin rpy="${0 * DEG2RAD} ${0 * DEG2RAD} ${0 * DEG2RAD}" xyz="${-6.0548104e-03 * mmTom} ${8.2902397e+01 * mmTom} ${6.0505209e+01 * mmTom}"/>
            <mass value="${7.3800519 + payload_mass}" />
            <inertia ixx="${4.4624842e+04 * kgmm2_2_kgm2}" iyy="${2.6977590e+04 * kgmm2_2_kgm2}" izz="${2.7956754e+04 * kgmm2_2_kgm2}"
                    ixy="${-1.4644878e+01 * kgmm2_2_kgm2}" ixz="${3.0225947e+01 * kgmm2_2_kgm2}" iyz="${9.6636358e+03 * kgmm2_2_kgm2}" />
        </inertial>
    </link>
    <joint name="rail_joint" type="prismatic">
        <parent link="test_rig" />
        <child link="body" />
        <origin xyz="0 ${test_rig_thickness + hip_mounting_offset} -${test_rig_height/2}" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 0 1" />
        <dynamics damping="${sliding_guide_dyn_friction}" friction="${sliding_guide_static_friction}" />
        <limit lower="0" upper="10.0" effort="1000" velocity="50.0"/>
    </joint>


    <joint name="hip_pitch_${id}" type="revolute">
        <parent link="body" />
        <child link="femur${id}" />
        <axis xyz="0 1 0"/>
        <origin xyz="0 ${214.6 * mmTom} 0" />
        <limit effort="112" lower="-2.4" upper="2.4" velocity="20.0"/>
    </joint>

    <link name="femur${id}">

		<visual name = "thigh_link_v">
			<origin xyz="0 0 -${thigh_height/2}" rpy="0 0 0"/>
			<geometry>
                <cylinder length="${thigh_height}" radius="${thigh_width/2}" />
			</geometry>
	   	</visual>
		<collision name = "thigh_link_c">
			<origin xyz="0 0 -${thigh_height/2}" rpy="0 0 0"/>
			<geometry>
                <cylinder length="${thigh_height}" radius="${thigh_width/2}" />
			</geometry>
	   	</collision>

        <inertial>
            <origin rpy="${femur_com_rpy}" xyz="${femur_com_xyz}"/>
            <mass value="3.3712777"/>
            <inertia ixx="${4.6647423e+04 * kgmm2_2_kgm2}" iyy="${4.3720135e+04 * kgmm2_2_kgm2}" izz="${7.5794813e+04 * kgmm2_2_kgm2}"
                ixy="${-1.2697640e+01 * kgmm2_2_kgm2}" ixz="${-3.2745810e+01 * kgmm2_2_kgm2}" iyz="${-6.3299091e+04 * kgmm2_2_kgm2}" />
        </inertial>
    </link>
    <joint name="femur${id}_com_joint" type="fixed">
        <origin rpy="${femur_com_rpy}" xyz="${femur_com_xyz}"/>
        <parent link="femur${id}"/>
        <child link="femur${id}_com"/>
    </joint>
    <link name="femur${id}_com">
        <xacro:small_inertial />
    </link>
    <!-- <gazebo reference='femur${id}_com_joint'>
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo> -->

    <joint name="knee_pitch_${id}" type="revolute">
        <parent link="femur${id}"/>
        <child link="shin${id}"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 ${-118.2 * mmTom} ${-300.0 * mmTom}"/>
        <axis xyz="0 -1 0"/>
        <limit effort="112" lower="-2.4" upper="2.4" velocity="20.0"/>
    </joint>

    <link name="shin${id}">
        <visual name = "shin_link_v">
			<origin xyz="0 0 -${(shin_height-shin_width)/2}" rpy="0 0 0"/>
			<geometry>
                <cylinder length="${shin_height-shin_width}" radius="${shin_width/2}" />
			</geometry>
	   	</visual>
		<collision name = "shin_link_c">
			<origin xyz="0 0 -${(shin_height-shin_width)/2}" rpy="0 0 0"/>
			<geometry>
                <cylinder length="${shin_height-shin_width}" radius="${shin_width/2}" />
			</geometry>
		</collision>
        <inertial>
            <origin rpy="${shin_com_rpy}" xyz="${shin_com_xyz}"/>
            <mass value="1.3106594"/>
            <inertia ixx="${4.0133965e+04 * kgmm2_2_kgm2}" iyy="${4.0269285e+04 * kgmm2_2_kgm2}" izz="${1.5274496e+03 * kgmm2_2_kgm2}"
                ixy="${4.6219082e-02 * kgmm2_2_kgm2}" ixz="${-3.0432320e-01 * kgmm2_2_kgm2}" iyz="${1.3816329e+03 * kgmm2_2_kgm2}" />
        </inertial>
    </link>
    <joint name="shin${id}_com_joint" type="fixed">
        <origin rpy="${shin_com_rpy}" xyz="${shin_com_xyz}"/>
        <parent link="shin${id}"/>
        <child link="shin${id}_com"/>
    </joint>
    <link name="shin${id}_com">
        <xacro:small_inertial/>
    </link>
    <!-- <gazebo reference='shin${id}_com_joint'>
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo> -->


    <link name="tip${id}"><visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shin_width}" />
            </geometry>
        </visual>
        <collision>
			<origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shin_width}" />
            </geometry>
        </collision>
		<xacro:small_inertial />
		<contact>
            <!-- 
            Pybullet defaults maybe are these (from bullet3/examples/Importers/ImportURDFDemo/URDFJointTypes.h line 33)
            URDFLinkContactInfo()
                : m_lateralFriction(0.5),
                m_rollingFriction(0),
                m_spinningFriction(0),
                m_restitution(0),
                m_inertiaScaling(1),
                m_contactCfm(0),
                m_contactErp(0),
                m_contactStiffness(1e4),
                m_contactDamping(1)
            -->
            <lateral_friction value="0.9"/>
            <rolling_friction value="0.01"/>
            <!-- <contact_cfm value="0.1 "/> -->
            <!-- <contact_erp value="0.2"/> -->
            <restitution value="0.05"/>
            <!-- <spinning_friction value="0"/> -->
            <!-- <friction_anchor value="0"/> -->
            <!-- <inertia_scaling value="0"/> -->
            <!-- <stiffness value="2500"/>
            <damping value="8"/>  -->
        </contact>
        <xacro:small_inertial />
    </link>
    <joint name="tip_joint_${id}" type="fixed">
        <parent link="shin${id}"/>
        <child link="tip${id}"/>
        <origin xyz="0.0 ${23.3000 * mmTom} ${-451 * mmTom}"/>
    </joint>

    <!-- <gazebo reference='tip_joint_${id}'>
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo> -->


</robot>
