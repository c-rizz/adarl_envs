<launch>

  <env name="ROSCONSOLE_FORMAT" value="[${severity}] [${walltime}] [${node}]: ${message}" />

  <!-- Args -->
  <arg name="world_name" default="$(dirname)/../gazebo/gazebo.world"/>
  <arg name="model_name" default="leg"/>
  <arg name="gui" default="false"/>
  <arg name="paused" default="true"/>


  <!-- Launching protoleg.world -->
  <include file="$(find protoleg)/launch/launch_sim_all.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="model_name" value="$(arg model_name)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

</launch>